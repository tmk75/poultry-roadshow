{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClimateTelemetryPayload",
  "description": "Schema for climate and air quality telemetry generated by Welotec egOS edge gateways in Sunner poultry barns",
  "type": "object",
  "required": [
    "schema_version",
    "gateway_id",
    "timestamp",
    "farm_id",
    "barn_id",
    "zone_id",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^gw-[a-z0-9-]+$"
    },
    "firmware_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "farm_id": {
      "type": "string"
    },
    "barn_id": {
      "type": "string"
    },
    "zone_id": {
      "type": "string",
      "enum": ["zone-front", "zone-mid", "zone-rear"]
    },
    "metrics": {
      "type": "object",
      "required": [
        "temperature_celsius",
        "relative_humidity_percent",
        "ammonia_nh3_ppm",
        "carbon_dioxide_co2_ppm",
        "air_velocity_mps"
      ],
      "properties": {
        "temperature_celsius": {
          "type": "number",
          "minimum": -10.0,
          "maximum": 55.0
        },
        "relative_humidity_percent": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "ammonia_nh3_ppm": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 150.0
        },
        "carbon_dioxide_co2_ppm": {
          "type": "number",
          "minimum": 300.0,
          "maximum": 10000.0
        },
        "air_velocity_mps": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "static_pressure_pa": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        }
      },
      "additionalProperties": false
    },
    "sensor_status": {
      "type": "object",
      "properties": {
        "nh3_sensor": { "type": "string", "enum": ["GOOD", "DEGRADED", "FAULT"] },
        "temp_sensor": { "type": "string", "enum": ["GOOD", "DEGRADED", "FAULT"] },
        "humidity_sensor": { "type": "string", "enum": ["GOOD", "DEGRADED", "FAULT"] }
      }
    }
  },
  "additionalProperties": false
}
