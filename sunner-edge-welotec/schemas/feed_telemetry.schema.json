{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeedTelemetryPayload",
  "description": "Schema for feed silo, pan weight, and water consumption telemetry generated by Welotec egOS edge gateways in Sunner poultry barns",
  "type": "object",
  "required": [
    "schema_version",
    "gateway_id",
    "timestamp",
    "farm_id",
    "barn_id",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^gw-[a-z0-9-]+$"
    },
    "firmware_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "farm_id": {
      "type": "string"
    },
    "barn_id": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "required": [
        "silo_1_weight_kg",
        "silo_2_weight_kg",
        "feed_consumed_daily_kg",
        "water_flow_liters_per_min",
        "feed_to_water_ratio"
      ],
      "properties": {
        "silo_1_weight_kg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 50000.0
        },
        "silo_2_weight_kg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 50000.0
        },
        "feed_consumed_daily_kg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 20000.0
        },
        "water_flow_liters_per_min": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 500.0
        },
        "feed_to_water_ratio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4.0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
